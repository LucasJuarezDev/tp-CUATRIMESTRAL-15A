## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/

# Visual Studio cache files
.vs/
*.dbmdl
*.dbproj.schemaview

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# IIS Express
IISExpress/
*.vspscc

# ASP.NET auto-generated files
Generated_Code/
App_Data/
App_Browser/
App_Offline.htm

# Logs
*.log

# NuGet Packages
*.nupkg
# Uncomment if necessary:
# packages/

# Node.js tools
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Compiled Libs
*.dll
*.exe

# Publish outputs
publish/
wwwroot/dist/
wwwroot/lib/

# Rider / JetBrains
.idea/
*.sln.iml

# Temp folders
temp/
tmp/
